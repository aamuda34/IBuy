# IBuy production environment
IBUY_HOST=0.0.0.0
# Render/managed hosts normally provide PORT automatically.
IBUY_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
IBUY_SECURE_COOKIES=1
IBUY_PUBLIC_BASE_URL=https://your-domain.example
IBUY_DB_PATH=/var/data/ibuy/ibuy.sqlite3

# Optional notifications
IBUY_NOTIFY_PROVIDER=resend
IBUY_NOTIFY_API_KEY=
IBUY_NOTIFY_FROM=IBuy <onboarding@resend.dev>
# Or for Termii:
# IBUY_NOTIFY_PROVIDER=termii
# IBUY_NOTIFY_API_KEY=
# IBUY_NOTIFY_SENDER_ID=IBuy

IBUY_BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example
IBUY_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_12_PLUS_CHARACTER_PASSWORD
